---
// Image gallery with captions. Each caption doubles as the image's alt text.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Reveal from "./Reveal.astro";

interface Props {
  items: { src: ImageMetadata; caption: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class:list={["gallery", { "gallery--single": items.length === 1 }]}>
      {items.map((item) => (
        <Reveal as="figure" class="gallery__item">
          <Image src={item.src} alt={item.caption} widths={[480, 800, 1200, 1600]} sizes="(max-width: 800px) 92vw, 640px" />
          <figcaption>{item.caption}</figcaption>
        </Reveal>
      ))}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 2rem;
    align-items: start;
  }
  .gallery--single {
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
  }
  .gallery :global(.gallery__item) {
    margin: 0;
  }
  .gallery img {
    width: 100%;
    border-radius: var(--radius-card);
    background: #fff;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    text-align: center;
  }
</style>
