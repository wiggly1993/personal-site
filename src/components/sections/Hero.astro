---
// Full-screen dark intro with the neural-network background image.
import { Image } from "astro:assets";
import { site } from "../../config/site";
import heroBg from "../../assets/site/title_background.png";
---

<section class="hero section--dark" aria-labelledby="hero-title">
  <Image
    class="hero__bg"
    src={heroBg}
    alt=""
    widths={[800, 1480]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <h1 id="hero-title" class="hero__title gradient-text">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__ctas">
      <a class="hero__cta hero__cta--primary" href="#featured">See my work</a>
      <a class="hero__cta link-more" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: var(--section-pad);
    text-align: center;
  }
  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    z-index: -2;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at center, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.75) 70%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.85));
  }
  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 700;
    letter-spacing: var(--ls-hero);
    padding-bottom: 0.08em;
    animation: hero-in 900ms var(--ease-out) both;
  }
  .hero__tagline {
    margin: 1.25rem auto 0;
    max-width: 30ch;
    font-size: var(--fs-lead);
    color: var(--color-text-on-dark);
    animation: hero-in 900ms 150ms var(--ease-out) both;
  }
  .hero__ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2rem;
    animation: hero-in 900ms 300ms var(--ease-out) both;
  }
  .hero__cta {
    font-size: 1.0625rem;
  }
  .hero__cta--primary {
    background: var(--color-accent);
    color: #fff !important;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 500;
  }
  .hero__cta--primary:hover {
    text-decoration: none;
    filter: brightness(1.1);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
  }
</style>
