---
// Project detail page, generated once per project folder.
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MetricStat from "../../components/ui/MetricStat.astro";
import Gallery from "../../components/ui/Gallery.astro";
import Reveal from "../../components/ui/Reveal.astro";
import { getProjects, coverAlt, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const { title, subtitle, summary, category, tags, metrics, cover, gallery, links, theme } = project.data;
const { Content } = await render(project);

// Don't repeat the cover in the gallery.
const galleryItems = gallery.filter((g) => !cover || g.src.src !== cover.src);

const linkLabels = { github: "GitHub", demo: "Live demo", paper: "Paper", slides: "Slides" } as const;
const linkList = (Object.keys(linkLabels) as (keyof typeof linkLabels)[])
  .filter((key) => links[key])
  .map((key) => ({ label: linkLabels[key], href: links[key]! }));
---

<BaseLayout title={title} description={summary} image={cover} type="article">
  <article>
    <header class:list={["hero", "section", theme === "dark" ? "section--dark theme-dark" : "section--alt"]}>
      <Reveal class="container hero__inner">
        <p class="hero__eyebrow">{category}</p>
        <h1 class="hero__title gradient-text">{title}</h1>
        <p class="hero__subtitle">{subtitle}</p>
        {
          metrics.length > 0 && (
            <div class="hero__metrics">
              {metrics.map((m) => (
                <MetricStat value={m.value} label={m.label} />
              ))}
            </div>
          )
        }
        {
          linkList.length > 0 && (
            <ul class="hero__links" role="list">
              {linkList.map((l) => (
                <li>
                  <a class="link-more" href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          )
        }
      </Reveal>
      {
        cover && (
          <Reveal class="container-wide hero__cover">
            <Image
              src={cover}
              alt={coverAlt(project)}
              widths={[640, 960, 1280, 1920]}
              sizes="(max-width: 1100px) 92vw, 1000px"
              loading="eager"
            />
          </Reveal>
        )
      }
    </header>

    <section class="section">
      <Reveal class="container prose">
        <Content />
      </Reveal>
    </section>

    {
      galleryItems.length > 0 && (
        <section class="section section--alt" aria-labelledby="gallery-title">
          <div class="container-wide">
            <h2 id="gallery-title" class="section-title gallery-title">Gallery.</h2>
            <Gallery items={galleryItems} />
          </div>
        </section>
      )
    }

    <footer class="section project-footer">
      <div class="container">
        {
          tags.length > 0 && (
            <ul class="tags" role="list" aria-label="Tags">
              {tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
        <nav class="pager" aria-label="More projects">
          {prev ? (
            <a class="pager__link" href={`/projects/${prev.id}/`}>
              <span class="pager__dir">‹ Previous</span>
              <span class="pager__title">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a class="pager__link pager__link--next" href={`/projects/${next.id}/`}>
              <span class="pager__dir">Next ›</span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          ) : <span />}
        </nav>
        <p class="all-link"><a class="link-more" href="/projects/">All projects</a></p>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .hero {
    text-align: center;
  }
  .hero__eyebrow {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .theme-dark .hero__eyebrow {
    color: var(--color-text-secondary-on-dark);
  }
  .hero__title {
    margin: 0.5rem auto 0;
    max-width: 16ch;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 5rem);
    font-weight: 700;
    letter-spacing: var(--ls-hero);
    padding-bottom: 0.08em;
  }
  .hero__subtitle {
    margin: 1rem auto 0;
    max-width: 32ch;
    font-size: var(--fs-lead);
  }
  .hero__metrics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    margin-top: 3rem;
  }
  .hero__links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .hero__cover {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    max-width: 1080px;
  }
  /* Show the whole image, never crop. */
  .hero__cover img {
    display: block;
    margin: 0 auto;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 640px;
    border-radius: var(--radius-tile);
    padding: clamp(0.5rem, 1.5vw, 1rem); /* keep rounded corners off the diagram */
    background: #fff;
  }

  /* Markdown body */
  .prose {
    max-width: calc(720px + 2 * var(--gutter));
  }
  .prose :global(h2) {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    margin: 3rem 0 1rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(strong) {
    font-weight: 650;
  }
  .prose :global(p:last-child) {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  /* A small image inside the text, e.g. a photo in the Problem section. */
  .prose :global(.inline-figure) {
    margin: 2rem 0;
  }
  .prose :global(.inline-figure p) {
    margin: 0;
    padding: 0;
    border: 0; /* not the "Tech:" line style */
  }
  .prose :global(.inline-figure img) {
    display: block;
    margin: 0 auto;
    width: 100%;
    max-width: 320px;
    height: auto;
    border-radius: var(--radius-tile);
  }

  /* Two short clips side by side (stacked on phones), e.g. before/after training. */
  .prose :global(.video-pair) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 2rem 0;
  }
  .prose :global(.video-pair figure) {
    margin: 0;
  }
  .prose :global(.video-pair video) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-tile);
    background: var(--color-bg-alt);
  }
  .prose :global(.video-pair figcaption) {
    margin-top: 0.625rem;
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .gallery-title {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .project-footer {
    padding-top: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 4rem;
    padding: 0;
  }
  /* After the grey gallery band the footer needs its own top padding. */
  .section--alt + .project-footer {
    padding-top: var(--section-pad);
  }
  .tags li {
    font-size: var(--fs-small);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    color: var(--color-text-secondary);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-text);
  }
  .pager__link:hover {
    text-decoration: none;
  }
  .pager__link:hover .pager__title {
    color: var(--color-accent);
  }
  .pager__link--next {
    text-align: right;
  }
  .pager__dir {
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
  }
  .pager__title {
    font-weight: 600;
    font-size: 1.0625rem;
    transition: color 0.2s;
  }
  .all-link {
    margin-top: 3rem;
    text-align: center;
  }
</style>
