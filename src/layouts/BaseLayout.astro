---
// Page shell: <head> with SEO + Open Graph tags, Nav, Footer, scroll-reveal script.
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import defaultOgImage from "../assets/site/title_background.png";

interface Props {
  title?: string; // page title; the site name is appended
  description?: string;
  image?: ImageMetadata; // Open Graph image; falls back to the hero background
  type?: "website" | "article";
}

const { title, description = site.description, image, type = "website" } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · AI Projects`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image ?? defaultOgImage, width: 1200, format: "jpeg" });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Lets CSS hide reveal elements only when JS is available to show them again. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
